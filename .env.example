# Copy to .env.local. Use the exact URL origin, without a trailing slash.
SPOTTER_ORIGIN=http://127.0.0.1:3000
# Development uses .data/spotter.sqlite by default. Production requires an absolute path.
# SPOTTER_DB_PATH=/var/lib/spotter/spotter.sqlite
# Generate a 32-character setup code locally. It can only register the first account.
SPOTTER_SETUP_CODE=
# Optional default login name for the local plans:import tool.
# SPOTTER_IMPORT_USER=
# Optional WHOOP OAuth app. Register <SPOTTER_ORIGIN>/api/health/whoop/callback.
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
