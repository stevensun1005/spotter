{
  "name": "spotter-duo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm --prefix cloudflare run dev",
    "build": "npm --prefix cloudflare run build",
    "start": "npm --prefix cloudflare start",
    "typecheck": "npm --prefix cloudflare run typecheck",
    "test": "node --test tests/*.test.mjs && npm --prefix cloudflare test",
    "test:health-native": "node tools/verify-health-native.mjs",
    "test:ios-app": "node tools/verify-ios-app.mjs",
    "ios:source-check": "node tools/check-app-source.mjs --fetch --upstream origin/main --upstream origin/codex/health-device-sync --upstream origin/codex/spotter-iphone-app",
    "ios:package": "node tools/build-ios-simulator.mjs",
    "ios:verify-archive": "node tools/verify-ios-archive.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.4"
  }
}
